# Doxygen-Konfiguration für InMemDB (wird von CMake mit @PROJECT_NAME@/@PROJECT_VERSION@ konfiguriert)
PROJECT_NAME      = "@PROJECT_NAME@"
PROJECT_NUMBER    = "@PROJECT_VERSION@"
PROJECT_BRIEF     = "In-Memory non-relationales Datenbanksystem (C++, objektorientiert, Pimpl)"

OUTPUT_DIRECTORY  = @CMAKE_CURRENT_BINARY_DIR@/docs
INPUT             = @CMAKE_CURRENT_SOURCE_DIR@/include @CMAKE_CURRENT_SOURCE_DIR@/README.md
RECURSIVE         = YES
FILE_PATTERNS     = *.hpp *.md
USE_MDFILE_AS_MAINPAGE = @CMAKE_CURRENT_SOURCE_DIR@/README.md

EXTRACT_ALL       = NO
EXTRACT_PRIVATE   = NO
EXTRACT_STATIC    = YES

GENERATE_HTML     = YES
HTML_OUTPUT       = html
GENERATE_LATEX    = NO

QUIET             = NO
WARNINGS          = YES
WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR = YES
WARN_NO_PARAMDOC  = YES
WARN_AS_ERROR     = NO

SORT_BY_SCOPE_NAME = YES

HAVE_DOT          = NO
CALL_GRAPH        = NO
CALLER_GRAPH      = NO
